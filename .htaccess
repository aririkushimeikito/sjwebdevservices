# SJ Webdev Services — Bluehost/Apache config

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ============================================================
  #  MAINTENANCE MODE  (backend toggle — no button, no code edits)
  #  The whole site shows a friendly "temporarily down" page (HTTP 503)
  #  ONLY while a file named  maintenance.on  exists in this folder.
  #    TAKE OFFLINE : create an empty file named  maintenance.on
  #    BRING BACK   : delete the  maintenance.on  file
  # ============================================================
  RewriteCond %{DOCUMENT_ROOT}/maintenance.on -f
  RewriteCond %{REQUEST_URI} !^/maintenance\.html$ [NC]
  RewriteRule ^ - [R=503,L]

  # ---- Pretty URLs (no .html extension) ----

  # Legacy combined page -> Services
  RewriteRule ^about-services(?:\.html)?/?$ /services [R=301,L]

  # /index or /index.html  ->  /   (home shows just the domain)
  RewriteCond %{THE_REQUEST} \s/+index(?:\.html)?[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # /page/index.html  ->  /page/   (folder pages: about/, services/, ...)
  RewriteCond %{THE_REQUEST} \s/+(.+?)/index(?:\.html)?[\s?] [NC]
  RewriteRule ^ /%1/ [R=301,L,QSA]

  # /page.html  ->  /page/  when a folder page exists (about/, services/, ...)
  RewriteCond %{THE_REQUEST} \s/+[^\s?]+\.html[\s?] [NC]
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+)\.html$ /$1/ [R=301,L,QSA]

  # /page.html  ->  /page   (any remaining flat page)
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,QSA]

  # Add the trailing slash to folder pages (e.g. /about -> /about/)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.+)$ /$1/ [R=301,L]

  # Remove a trailing slash from non-directory URLs (e.g. /foo/ -> /foo)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+?)/+$ /$1 [R=301,L]

  # Internally serve /page from page.html (legacy flat pages, if any)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Error pages
ErrorDocument 503 /maintenance.html
ErrorDocument 404 /404.html

# Basic caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType video/mp4 "access plus 6 months"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
