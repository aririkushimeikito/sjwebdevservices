# SJ Webdev Services — Bluehost/Apache config

# ============================================================
#  MAINTENANCE MODE  (backend toggle — no button, no code edits)
#  The whole site shows a friendly "temporarily down" page (HTTP 503)
#  ONLY while a file named  maintenance.on  exists in this folder.
#
#    TAKE THE SITE OFFLINE :  create an empty file named  maintenance.on
#         (cPanel > File Manager > public_html > "+ File")
#    BRING THE SITE BACK   :  delete the  maintenance.on  file
#
#  When the flag file is gone the site is 100% back to normal — no other
#  change needed. 503 tells Google it's only temporary (SEO-safe).
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{DOCUMENT_ROOT}/maintenance.on -f
  RewriteCond %{REQUEST_URI} !^/maintenance\.html$ [NC]
  RewriteRule ^ - [R=503,L]
</IfModule>
ErrorDocument 503 /maintenance.html

# Redirect the old combined About/Services URL to the new Services page
Redirect 301 /about-services.html /services.html

# Custom 404 page
ErrorDocument 404 /404.html

# Basic caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
